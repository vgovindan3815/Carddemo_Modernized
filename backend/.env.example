# Neon PostgreSQL connection string (required)
# Get this from https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx-yyy.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server port (optional, defaults to 3000)
PORT=3000

# Session secret — change to a long random string in production
SESSION_SECRET=change-me-in-production

# Log level: trace | debug | info | warn | error (optional, defaults to info)
LOG_LEVEL=info

# Batch job output directory (optional, defaults to backend/output)
BATCH_OUTPUT_DIR=

# Default input file paths for batch jobs (optional — jobs fall back to legacy ASCII files)
ACCTFILE_INPUT_FILE=data/input/acctdata.txt
CUSTFILE_INPUT_FILE=data/input/custdata.txt
CARDFILE_INPUT_FILE=data/input/carddata.txt
CARDXREF_INPUT_FILE=data/input/cardxref.txt
